        "import numpy as np\n",
        "\n",
        "data = np.load(\"subdata.npy\")\n",
        "data = data.reshape(64, 64, 64, 49, order=\"F\")\n",
        "\n",
        "print(data.shape)\n",
        "\n",
        "Nx, Ny, Nz, T = data.shape #Task 1\n",
        "\n",
        "avg_power = np.zeros((Nx, Ny, Nz), dtype=np.float64)\n",
        "\n",
        "for t in range (T):\n",
        "  U = np.fft.fftn(data[:,:,:,t])\n",
        "  U = np.fft.fftshift(U)\n",
        "  avg_power +=np.abs(U)**2\n",
        "\n",
        "avg_power /= T\n",
        "\n",
        "center = (Nx//2, Ny//2, Nz//2)\n",
        "\n",
        "avg_power_no_dc = avg_power.copy()\n",
        "avg_power_no_dc[center] = 0\n",
        "\n",
        "peak_idx = np.unravel_index(np.argmax(avg_power_no_dc), avg_power_no_dc.shape)\n",
        "print(\"Peak index (shifted grid):\", peak_idx)\n",
        "print(\"Peak power:\", avg_power[peak_idx])\n",
        "\n",
        "L = 10  # <-- change if your notebook says a different L\n",
        "N = 64\n",
        "dx = (2*L)/N\n",
        "\n",
        "kx = 2*np.pi * np.fft.fftshift(np.fft.fftfreq(N, d=dx))\n",
        "ky = 2*np.pi * np.fft.fftshift(np.fft.fftfreq(N, d=dx))\n",
        "kz = 2*np.pi * np.fft.fftshift(np.fft.fftfreq(N, d=dx))\n",
        "\n",
        "i, j, k = peak_idx\n",
        "k0 = np.array([kx[i], ky[j], kz[k]])\n",
        "k0_mag = np.linalg.norm(k0)\n",
        "\n",
        "print(\"Center frequency vector k0 =\", k0)\n",
        "print(\"Center frequency magnitude |k0| =\", k0_mag)\n",
        "\n",
        "import matplotlib.pyplot as plt #Sanity Plot\n",
        "\n",
        "mid = Nz//2\n",
        "plt.imshow(np.log1p(avg_power[:, :, mid]), origin=\"lower\")\n",
        "plt.colorbar()\n",
        "plt.title(\"log(1 + avg power spectrum), z-mid slice\")\n",
        "plt.show()\n",
        "\n",
        "from numpy.fft import fftn, ifftn, fftshift, ifftshift #task 2\n",
        "\n",
        "nx, ny, nz, nt = data.shape\n",
        "\n",
        "# Average the Fourier magnitude over time (reduces random noise)\n",
        "spec_avg = np.zeros((nx, ny, nz), dtype=np.float64)\n",
        "\n",
        "for t in range(nt):\n",
        "    F = fftshift(fftn(data[..., t]))\n",
        "    spec_avg += np.abs(F)\n",
        "\n",
        "spec_avg /= nt\n",
        "\n",
        "# Ignore the DC component (often huge) by zeroing a small cube around the center\n",
        "cx, cy, cz = nx//2, ny//2, nz//2\n",
        "r0 = 2\n",
        "spec_avg[cx-r0:cx+r0+1, cy-r0:cy+r0+1, cz-r0:cz+r0+1] = 0\n",
        "\n",
        "# Peak frequency index in shifted coordinates\n",
        "peak_idx = np.unravel_index(np.argmax(spec_avg), spec_avg.shape)\n",
        "print(\"Peak index (shifted coords):\", peak_idx)\n",
        "\n",
        "#task 3\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from numpy.fft import fftn, ifftn, fftshift, ifftshift\n",
        "\n",
        "# Load\n",
        "data = np.load(\"subdata.npy\")\n",
        "\n",
        "# Reshape if flattened\n",
        "if data.shape == (64*64*64, 49):\n",
        "    data = data.reshape(64, 64, 64, 49)\n",
        "\n",
        "print(\"data shape:\", data.shape)  # should be (64, 64, 64, 49)\n",
        "nx, ny, nz, nt = data.shape\n",
        "\n",
        "# Average spectrum magnitude over time\n",
        "spec_avg = np.zeros((nx, ny, nz), dtype=np.float64)\n",
        "for t in range(nt):\n",
        "    F = fftshift(fftn(data[..., t]))\n",
        "    spec_avg += np.abs(F)\n",
        "spec_avg /= nt\n",
        "\n",
        "# Remove DC peak (center)\n",
        "cx, cy, cz = nx//2, ny//2, nz//2\n",
        "spec_avg[cx-2:cx+3, cy-2:cy+3, cz-2:cz+3] = 0\n",
        "\n",
        "peak_idx = np.unravel_index(np.argmax(spec_avg), spec_avg.shape)\n",
        "print(\"peak index (shifted grid):\", peak_idx)\n",
        "\n",
        "# Build k-grid\n",
        "kx = np.arange(nx) - nx//2\n",
        "ky = np.arange(ny) - ny//2\n",
        "kz = np.arange(nz) - nz//2\n",
        "KX, KY, KZ = np.meshgrid(kx, ky, kz, indexing=\"ij\")\n",
        "\n",
        "# Convert peak index to shifted coordinates\n",
        "k0x, k0y, k0z = peak_idx[0]-nx//2, peak_idx[1]-ny//2, peak_idx[2]-nz//2\n",
        "\n",
        "# Filter width (tune if needed)\n",
        "sigma = 3.0\n",
        "\n",
        "# Gaussian around +k0 and -k0\n",
        "mask = np.exp(-((KX-k0x)**2+(KY-k0y)**2+(KZ-k0z)**2)/(2*sigma**2))\n",
        "mask += np.exp(-((KX+k0x)**2+(KY+k0y)**2+(KZ+k0z)**2)/(2*sigma**2))\n",
        "mask /= mask.max()\n",
        "\n",
        "print(\"mask ready\")\n",
        "\n",
        "path_idx = np.zeros((nt, 3), dtype=int)\n",
        "\n",
        "for t in range(nt):\n",
        "    F = fftshift(fftn(data[..., t]))\n",
        "    u = ifftn(ifftshift(F * mask))\n",
        "    path_idx[t] = np.unravel_index(np.argmax(np.abs(u)), u.shape)\n",
        "\n",
        "print(\"path_idx shape:\", path_idx.shape)  # (49, 3)\n",
        "print(\"first 5 positions:\", path_idx[:5])\n",
        "\n",
        "# Time axis: 49 measurements across 24 hours\n",
        "t_hours = np.linspace(0, 24, nt)\n",
        "\n",
        "x_t = path_idx[:, 0]\n",
        "y_t = path_idx[:, 1]\n",
        "\n",
        "# x(t)\n",
        "plt.figure()\n",
        "plt.plot(t_hours, x_t, marker='o')\n",
        "plt.xlabel(\"Time (hours)\")\n",
        "plt.ylabel(\"x coordinate\")\n",
        "plt.title(\"Task 3: x(t) over 24 hours\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# y(t)\n",
        "plt.figure()\n",
        "plt.plot(t_hours, y_t, marker='o')\n",
        "plt.xlabel(\"Time (hours)\")\n",
        "plt.ylabel(\"y coordinate\")\n",
        "plt.title(\"Task 3: y(t) over 24 hours\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# x-y trajectory\n",
        "plt.figure()\n",
        "plt.plot(x_t, y_t, marker='o')\n",
        "plt.xlabel(\"x\")\n",
        "plt.ylabel(\"y\")\n",
        "plt.title(\"Task 3: Submarine trajectory in x–y plane\")\n",
        "plt.axis(\"equal\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# =========================\n",
        "# Task 2 (Colab): Filtering + 3D Path Extraction\n",
        "# =========================\n",
        "# Assumptions (match HW description):\n",
        "# - You have a data file: subdata.npy (or .mat/.csv)\n",
        "# - Data contains 49 time snapshots, each snapshot is 64x64x64\n",
        "# - We'll:\n",
        "#   (1) FFT each snapshot (3D)\n",
        "#   (2) Build a frequency-domain filter around the dominant frequency k0 (from Task 1)\n",
        "#   (3) Apply filter, inverse FFT\n",
        "#   (4) Find submarine location by argmax in physical space\n",
        "#   (5) Plot 3D path and x(t), y(t)\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from mpl_toolkits.mplot3d import Axes3D\n",
        "\n",
        "# -------------------------\n",
        "# 1) Load data\n",
        "# -------------------------\n",
        "# In Colab: upload subdata.npy using the left file panel or:\n",
        "# from google.colab import files\n",
        "# files.upload()\n",
        "\n",
        "DATA_PATH = \"subdata.npy\"   # <-- change if needed\n",
        "subdata = np.load(DATA_PATH)\n",
        "\n",
        "print(\"Loaded subdata shape:\", subdata.shape)\n",
        "\n",
        "# ---- reshape/interpretation helper ----\n",
        "# Common formats seen in this HW:\n",
        "# A) (64,64,64,49)  or  B) (49,64,64,64)  or  C) (64**3,49)\n",
        "# We'll convert everything to (T, Nx, Ny, Nz).\n",
        "\n",
        "def to_Txyz(arr, Nx=64, Ny=64, Nz=64):\n",
        "    if arr.shape == (Nx, Ny, Nz, 49):\n",
        "        return np.transpose(arr, (3,0,1,2))\n",
        "    if arr.shape == (49, Nx, Ny, Nz):\n",
        "        return arr\n",
        "    if arr.shape == (Nx*Nx*Nx, 49) or arr.shape == (Nx*Ny*Nz, 49):\n",
        "        T = arr.shape[1]\n",
        "        out = np.zeros((T, Nx, Ny, Nz), dtype=arr.dtype)\n",
        "        for t in range(T):\n",
        "            out[t] = arr[:, t].reshape((Nx, Ny, Nz), order=\"F\")  # sometimes Fortran order\n",
        "        return out\n",
        "    if arr.shape == (49, Nx*Ny*Nz):\n",
        "        out = np.zeros((49, Nx, Ny, Nz), dtype=arr.dtype)\n",
        "        for t in range(49):\n",
        "            out[t] = arr[t].reshape((Nx, Ny, Nz), order=\"F\")\n",
        "        return out\n",
        "    raise ValueError(f\"Unrecognized shape {arr.shape}. You may need to reshape manually.\")\n",
        "\n",
        "X = to_Txyz(subdata, 64, 64, 64)\n",
        "T, Nx, Ny, Nz = X.shape\n",
        "print(\"Using X shape (T,Nx,Ny,Nz):\", X.shape)\n",
        "\n",
        "# -------------------------\n",
        "# 2) Build frequency grid (for fftshifted spectra)\n",
        "# -------------------------\n",
        "# We use k indices consistent with fftshift ordering.\n",
        "kx = np.fft.fftshift(np.fft.fftfreq(Nx) * Nx)  # integer-like grid: -N/2,...,N/2-1\n",
        "ky = np.fft.fftshift(np.fft.fftfreq(Ny) * Ny)\n",
        "kz = np.fft.fftshift(np.fft.fftfreq(Nz) * Nz)\n",
        "KX, KY, KZ = np.meshgrid(kx, ky, kz, indexing=\"ij\")\n",
        "\n",
        "# -------------------------\n",
        "# 3) Get dominant frequency k0 (from Task 1)\n",
        "# -------------------------\n",
        "# If you already know k0 = (k0x,k0y,k0z), enter it here:\n",
        "# Example placeholder:\n",
        "k0 = None  # <-- set this to a tuple like (k0x, k0y, k0z) once you know it\n",
        "\n",
        "# If you *don't* have it, you can estimate it by averaging spectra and finding the max:\n",
        "# (This is \"Task 1-ish\", but it's convenient if you want everything in one notebook.)\n",
        "\n",
        "def estimate_k0_from_avg_spectrum(X):\n",
        "    T = X.shape[0]\n",
        "    avg_spec = np.zeros((Nx,Ny,Nz), dtype=np.float64)\n",
        "    for t in range(T):\n",
        "        F = np.fft.fftn(X[t])\n",
        "        Fsh = np.fft.fftshift(F)\n",
        "        avg_spec += np.abs(Fsh)\n",
        "    avg_spec /= T\n",
        "    # ignore the DC component (center) to avoid picking k=(0,0,0) if it dominates\n",
        "    cx, cy, cz = Nx//2, Ny//2, Nz//2\n",
        "    avg_spec[cx-1:cx+2, cy-1:cy+2, cz-1:cz+2] = 0.0\n",
        "\n",
        "    idx = np.unravel_index(np.argmax(avg_spec), avg_spec.shape)\n",
        "    k0x = int(kx[idx[0]])\n",
        "    k0y = int(ky[idx[1]])\n",
        "    k0z = int(kz[idx[2]])\n",
        "    return (k0x, k0y, k0z), avg_spec\n",
        "\n",
        "if k0 is None:\n",
        "    k0, avg_spec = estimate_k0_from_avg_spectrum(X)\n",
        "    print(\"Estimated dominant k0 (from averaged spectrum):\", k0)\n",
        "\n",
        "# -------------------------\n",
        "# 4) Build filter G(k)\n",
        "# -------------------------\n",
        "# Lecture-based idea: keep frequencies near k0 and suppress others.\n",
        "# We'll use a Gaussian in frequency space centered at k0.\n",
        "# sigma controls bandwidth: smaller sigma = narrower filter.\n",
        "sigma = 2.0  # <-- tune this (typical: 1.5 to 4)\n",
        "\n",
        "k0x, k0y, k0z = k0\n",
        "G = np.exp(-((KX - k0x)**2 + (KY - k0y)**2 + (KZ - k0z)**2)/(2*sigma**2))\n",
        "\n",
        "# Optional: also keep the symmetric peak at -k0 (sometimes helps for real signals)\n",
        "G2 = np.exp(-((KX + k0x)**2 + (KY + k0y)**2 + (KZ + k0z)**2)/(2*sigma**2))\n",
        "G = np.maximum(G, G2)\n",
        "\n",
        "# -------------------------\n",
        "# 5) Filter each snapshot and localize submarine\n",
        "# -------------------------\n",
        "# For each t:\n",
        "#   - FFT -> shift -> multiply by G -> inverse shift -> iFFT\n",
        "#   - find argmax in |filtered field|\n",
        "# store indices as (ix,iy,iz)\n",
        "\n",
        "path_idx = np.zeros((T, 3), dtype=int)\n",
        "peak_vals = np.zeros(T)\n",
        "\n",
        "for t in range(T):\n",
        "    F = np.fft.fftn(X[t])\n",
        "    Fsh = np.fft.fftshift(F)\n",
        "    Ffilt_sh = G * Fsh\n",
        "    Ffilt = np.fft.ifftshift(Ffilt_sh)\n",
        "    x_filt = np.fft.ifftn(Ffilt)\n",
        "\n",
        "    mag = np.abs(x_filt)\n",
        "    idx = np.unravel_index(np.argmax(mag), mag.shape)\n",
        "    path_idx[t] = np.array(idx, dtype=int)\n",
        "    peak_vals[t] = mag[idx]\n",
        "\n",
        "print(\"First 5 detected indices (ix,iy,iz):\\n\", path_idx[:5])\n",
        "print(\"Peak magnitude (first 5):\", peak_vals[:5])\n",
        "\n",
        "# -------------------------\n",
        "# 6) Convert indices to physical coordinates\n",
        "# -------------------------\n",
        "# If your spatial grid corresponds to 0..63 indices, you can use indices directly.\n",
        "# If your lecture notebook uses x in [0,2pi), map index -> physical coordinate:\n",
        "# x = 2pi * n / N\n",
        "use_physical_coords = False  # set True if you want [0,2pi) coordinates\n",
        "\n",
        "if use_physical_coords:\n",
        "    xs = 2*np.pi*path_idx[:,0]/Nx\n",
        "    ys = 2*np.pi*path_idx[:,1]/Ny\n",
        "    zs = 2*np.pi*path_idx[:,2]/Nz\n",
        "else:\n",
        "    xs = path_idx[:,0]\n",
        "    ys = path_idx[:,1]\n",
        "    zs = path_idx[:,2]\n",
        "\n",
        "# time vector: 49 snapshots over 24 hours in half-hour increments\n",
        "t_hours = np.linspace(0, 24, T)\n",
        "\n",
        "# -------------------------\n",
        "# 7) Plots (Task 2 outputs)\n",
        "# -------------------------\n",
        "# 3D path\n",
        "fig = plt.figure(figsize=(7,6))\n",
        "ax = fig.add_subplot(111, projection=\"3d\")\n",
        "ax.plot(xs, ys, zs, marker=\"o\")\n",
        "ax.set_title(\"Submarine 3D path (from filtered data)\")\n",
        "ax.set_xlabel(\"x\")\n",
        "ax.set_ylabel(\"y\")\n",
        "ax.set_zlabel(\"z\")\n",
        "plt.show()\n",
        "\n",
        "# x(t)\n",
        "plt.figure(figsize=(7,4))\n",
        "plt.plot(t_hours, xs, marker=\"o\")\n",
        "plt.title(\"x(t) over 24 hours\")\n",
        "plt.xlabel(\"Time (hours)\")\n",
        "plt.ylabel(\"x coordinate\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# y(t)\n",
        "plt.figure(figsize=(7,4))\n",
        "plt.plot(t_hours, ys, marker=\"o\")\n",
        "plt.title(\"y(t) over 24 hours\")\n",
        "plt.xlabel(\"Time (hours)\")\n",
        "plt.ylabel(\"y coordinate\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Optional: x-y trajectory\n",
        "plt.figure(figsize=(6,6))\n",
        "plt.plot(xs, ys, marker=\"o\")\n",
        "plt.title(\"Submarine trajectory in x-y plane\")\n",
        "plt.xlabel(\"x\")\n",
        "plt.ylabel(\"y\")\n",
        "plt.grid(True)\n",
        "plt.axis(\"equal\")\n",
        "plt.show()\n",
        "\n",
        "\n"
      ]
